# Copy this file to .env.local (for running on your computer)
# or paste each line into Vercel → Project → Settings → Environment Variables.

# 1) Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model writes the breakdowns
ANTHROPIC_MODEL=claude-sonnet-5-5

# 2) ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_...

# The voice to speak with (your cloned voice). Find it in ElevenLabs → Voices → your voice → "ID".
ELEVENLABS_VOICE_ID=

# Optional: ElevenLabs model
ELEVENLABS_MODEL=eleven_multilingual_v2

# 3) Passcode so strangers can't spend your credits. Give it to your students.
APP_PASSCODE=change-me
