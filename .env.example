# Copy this file to .env.local (for running on your computer)
# or paste each line into Vercel → Project → Settings → Environment Variables.
# Only the first block is required. Everything else switches on a feature when you fill it in.

# ---------- Required ----------
# Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# ElevenLabs: elevenlabs.io → Developers → API Keys. Voices, model and settings live in lib/voices.ts.
ELEVENLABS_API_KEY=sk_...
# Teacher password (opens /teacher). Long and random.
APP_PASSCODE=change-me
# Database: Vercel → Storage → Upstash Redis → Connect adds KV_REST_API_URL and KV_REST_API_TOKEN by itself.
# Recordings: Vercel → Storage → Blob → Connect adds BLOB_READ_WRITE_TOKEN by itself.

# ---------- Optional: models ----------
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Telegram bot (daily phrase, Stars payments, alerts to you) ----------
# Create the bot in @BotFather, paste the token, redeploy, then press "Подключить бота" in /teacher → Telegram.
TELEGRAM_BOT_TOKEN=
# Its @username without @ (shows the "Open in Telegram" button on the landing page)
TELEGRAM_BOT_USERNAME=
# Where payment alerts and the morning report go. Easiest: send /admin <APP_PASSCODE> to your bot instead.
TEACHER_CHAT_ID=

# ---------- Shadow Pro prices ----------
PRO_STARS=450
PRO_PRICE_RUB=690 ₽
PRO_PRICE_USD=$9

# ---------- Card payments: lava.top (Russian and foreign cards) ----------
# lava.top → Профиль → API ключи
LAVA_API_KEY=
# The subscription product's price (offer) id: lava.top → your product → price → id
LAVA_OFFER_ID=
# Any long random string. Put the same value in lava.top → Webhooks (auth: API key), URL https://<your-site>/api/pay/lava
LAVA_WEBHOOK_SECRET=
# MONTHLY for a subscription product, ONE_TIME for a one-off "30 days" product
LAVA_PERIODICITY=MONTHLY

# ---------- Email with the personal link after card payments (optional): resend.com ----------
RESEND_API_KEY=
EMAIL_FROM=Neuro-Fluent Shadow <shadow@yourdomain.com>

# ---------- Site, legal, analytics ----------
# Your own domain once you connect one (also used in sitemap and share previews)
NEXT_PUBLIC_SITE_URL=https://neuro-fluent-shadow-faj3.vercel.app
# Shown in the terms and privacy policy
LEGAL_NAME=ИП ...
LEGAL_ID=
SUPPORT_EMAIL=
CONTACT_URL=https://t.me/rawmeatsalad
# Yandex Metrica counter id (digits only), Google/Yandex site verification codes
NEXT_PUBLIC_YM_ID=
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# ---------- Safety ----------
# Vercel sends this with the daily job. Any long random string.
CRON_SECRET=
# Free visitors' total daily budget (1 = default). Raise when you run ads, lower if costs jump.
FREE_BUDGET_SCALE=1

# ---------- Android app ----------
# Google Play's app-signing key SHA-256 (Play Console → App integrity), comma-separated if several
ANDROID_SHA256=
